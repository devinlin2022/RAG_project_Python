# ── LLM: SiliconFlow DeepSeek (OpenAI-compatible) ──────────────────
# Base URL must end with /v1
LLM_BASE_URL=https://api.siliconflow.cn/v1
# Create at https://cloud.siliconflow.cn/account/ak (starts with sk-)
LLM_API_KEY=
# Full model id copied from the model plaza
# List available ids: python check_llm.py
LLM_MODEL=deepseek-ai/DeepSeek-V3

# 0.1 ~ 0.3 for extraction-style QA
TEMPERATURE=0.2
MAX_TOKENS=1024
LLM_TIMEOUT=90

# ── Public tunnel (optional) ──────────────────────────────────────
# Set true to expose the UI through ngrok. Local use works without it.
NGROK_ENABLED=false
# https://dashboard.ngrok.com/get-started/your-authtoken
# Never commit this value: .env is gitignored, .env.example is not.
NGROK_AUTHTOKEN=

# ── PDF parsing (V1) ──────────────────────────────────────────────
# Pages with fewer chars than this are treated as scanned
SCAN_PAGE_CHAR_THRESHOLD=200
# Share of columnar lines (0~1) above which a page is treated as a table
TABLE_COLUMN_RATIO=0.4
# Max context chars for page-scoped QA
MAX_CONTEXT_CHARS=12000

# ── OCR / figure rails (V2) ───────────────────────────────────────
# Off by default: vision calls cost money and take seconds per page
OCR_ENABLED=false
# Leave empty to reuse LLM_BASE_URL / LLM_API_KEY
OCR_BASE_URL=
OCR_API_KEY=
# OCR model. PaddleOCR-VL is free on SiliconFlow.
OCR_MODEL=Qwen/Qwen3-VL-32B-Instruct
# Figure captioning model. Reads arrows, which OCR cannot.
VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct
# Render DPI for OCR. 150 is enough for body text; 200 for small print
OCR_RENDER_DPI=150
# Page budget per run; remaining pages are skipped and flagged in the UI
OCR_MAX_PAGES=20
OCR_TIMEOUT=120
# Hard stop for a whole enhancement run
ENHANCE_MAX_SECONDS=120

# ── Embeddings (semantic chunking) ────────────────────────────────
# bge-m3 is free on SiliconFlow, 1024 dims, 8192 token window
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=BAAI/bge-m3
EMBED_BATCH=32

# ── Chunking (V2) ─────────────────────────────────────────────────
# auto | hybrid | structured | semantic | recursive
CHUNK_STRATEGY=auto
CHUNK_SIZE=500
CHUNK_OVERLAP=80
# Chunks below this are merged with a sibling when they still fit
CHUNK_MIN_CHARS=120
# Breakpoint percentile for semantic splitting
SEMANTIC_PERCENTILE=85
