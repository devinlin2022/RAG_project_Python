# ─────────────────────────────────────────────
#  只填这两行就能跑：一个 Key，一个地址，全部能力共用
# ─────────────────────────────────────────────
# https://cloud.siliconflow.cn/account/ak  （sk- 开头）
SILICONFLOW_API_KEY=
# .cn 与 .com 是两套站点，Key 与模型目录不通用
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 四个模型各司其职，都在这一个平台上。留空即用这里的默认值。
LLM_MODEL=deepseek-ai/DeepSeek-V3.2
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct

# 想知道这把 Key 能用哪些模型：python check_llm.py --models
# 想确认四个模型各自通不通：  python check_llm.py

# ── 回答 ──────────────────────────────────────
TEMPERATURE=0.2
MAX_TOKENS=1024
LLM_TIMEOUT=90
HISTORY_TURNS=3
# 追问（"那它呢"）先用模型改写成独立问题，关掉可省一次调用
REWRITE_ENABLED=true

# ── 解析 ──────────────────────────────────────
# 同一批上传里并行解析的文件数
PARSE_WORKERS=4
# 少于这个字符数视为扫描页
SCAN_PAGE_CHAR_THRESHOLD=200
# 列结构行占比超过它视为表格页
TABLE_COLUMN_RATIO=0.4
# 走 pdfplumber 精查表格的页数上限（只查"看起来像表格"的页）
TABLE_SCAN_MAX_PAGES=40
# Word / Markdown / Excel 没有真实页码，按这个字数切成虚拟页
NATIVE_PAGE_CHARS=1800

# ── 视觉识别（扫描页 OCR / 图表描述）——默认关闭，开启会计费 ──
OCR_ENABLED=false
OCR_RENDER_DPI=150
# 每次最多调用模型的页数
OCR_MAX_PAGES=20
OCR_TIMEOUT=120
# 并发调用数；1 = 串行。20 页扫描件从约 4 分钟降到约 1 分钟
OCR_CONCURRENCY=3
# 两次请求的最小间隔（秒），0 = 不节流
OCR_MIN_INTERVAL=0
ENHANCE_MAX_SECONDS=600
HTTP_RETRIES=3

# ── 向量与切分 ────────────────────────────────
EMBED_BATCH=32
# 建索引时并发的 embedding 批数
EMBED_CONCURRENCY=3
# auto | hybrid | structured | semantic | recursive
CHUNK_STRATEGY=auto
CHUNK_SIZE=500
CHUNK_OVERLAP=80
CHUNK_MIN_CHARS=120
SEMANTIC_PERCENTILE=85

# ── 检索 ──────────────────────────────────────
# rrf | dense | sparse
RETRIEVE_STRATEGY=rrf
RETRIEVE_TOP_K=6
# 精排前保留的候选数（"增强检索"模式内部会放大到 36）
RERANK_CANDIDATES=24
RRF_K=60
RERANK_ENABLED=true
RERANK_TIMEOUT=60

# ── 存储 ──────────────────────────────────────
DB_FILENAME=rag.sqlite
MAX_UPLOAD_MB=60

# ── 用量计费展示（留 0 = 只统计 token，不显示金额）────
# 元 / 百万 tokens，按控制台当前价格填写
PRICE_IN_PER_M=0
PRICE_OUT_PER_M=0

# ── 访问控制 ──────────────────────────────────
# 本地用 127.0.0.1；Colab / Docker 用 0.0.0.0（程序会自动判断）
APP_HOST=127.0.0.1
APP_PORT=7860
# 留空 = 不校验；填了就要求请求头 X-API-Key
APP_API_KEY=
# 留空 = 界面不登录
UI_USERNAME=admin
UI_PASSWORD=
RATE_LIMIT_PER_MIN=30
LOG_JSON=true

# ── 公网隧道（Colab 用，本地不需要）──────────
# 填了 token 就自动开启，不必再设 NGROK_ENABLED
NGROK_AUTHTOKEN=
NGROK_ENABLED=false
