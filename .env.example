# ── LLM: SiliconFlow (OpenAI-compatible) ──────────────────────────
# Base URL must end with /v1. .cn and .com are different sites:
# keys and model catalogues are NOT interchangeable.
LLM_BASE_URL=https://api.siliconflow.cn/v1
# Create at https://cloud.siliconflow.cn/account/ak (starts with sk-)
LLM_API_KEY=
# Full model id copied from the model plaza
LLM_MODEL=deepseek-ai/DeepSeek-V3

# 0.1 ~ 0.3 for extraction-style QA
TEMPERATURE=0.2
MAX_TOKENS=1024
LLM_TIMEOUT=90

# ── Public tunnel (optional) ──────────────────────────────────────
NGROK_ENABLED=false
NGROK_AUTHTOKEN=

# ── PDF parsing (V1) ──────────────────────────────────────────────
# Pages with fewer chars than this are treated as scanned
SCAN_PAGE_CHAR_THRESHOLD=200
# Share of columnar lines (0~1) above which a page is treated as a table
TABLE_COLUMN_RATIO=0.4
# Max context chars for page-scoped QA
MAX_CONTEXT_CHARS=12000

# ── OCR / figure rails (V2) ───────────────────────────────────────
# Off by default: vision calls cost money and take seconds per page
OCR_ENABLED=false
# Leave empty to reuse LLM_BASE_URL / LLM_API_KEY
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=Qwen/Qwen3-VL-32B-Instruct
VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct
OCR_RENDER_DPI=150
# Page budget per run; remaining pages are skipped and flagged in the UI
OCR_MAX_PAGES=20
OCR_TIMEOUT=120
OCR_MIN_INTERVAL=1.5
# Hard stop for a whole enhancement run
ENHANCE_MAX_SECONDS=600

# ── Embeddings (vector index) ─────────────────────────────────────
# bge-m3 is multilingual, 1024 dims, 8192 token window
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=BAAI/bge-m3
EMBED_BATCH=32

# ── Chunking (V2) ─────────────────────────────────────────────────
# auto | hybrid | structured | semantic | recursive
CHUNK_STRATEGY=auto
CHUNK_SIZE=500
CHUNK_OVERLAP=80
# Chunks below this are merged with a sibling when they still fit
CHUNK_MIN_CHARS=120
SEMANTIC_PERCENTILE=85

# ── Retrieval (V3) ────────────────────────────────────────────────
# rrf | dense | sparse
RETRIEVE_STRATEGY=rrf
RETRIEVE_TOP_K=6
# Candidates passed to the reranker before truncating to top_k
RERANK_CANDIDATES=24
RRF_K=60
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TIMEOUT=60

# ── Multi-turn (V4) ───────────────────────────────────────────────
HISTORY_TURNS=3
# Rewrite a follow-up question before retrieval; costs one short call
REWRITE_ENABLED=true

# ── Storage (V5) ──────────────────────────────────────────────────
DB_FILENAME=rag.sqlite
MAX_UPLOAD_MB=60

# ── Hardening (V7) ────────────────────────────────────────────────
# Bind 0.0.0.0 inside Docker, keep 127.0.0.1 locally
APP_HOST=127.0.0.1
APP_PORT=7860
# Empty = open access. Set a value to require X-API-Key on every /ask, /ingest…
APP_API_KEY=
# Empty password = no login page on the Gradio UI
UI_USERNAME=admin
UI_PASSWORD=
RATE_LIMIT_PER_MIN=30
# JSON logs with secrets masked as sk-***
LOG_JSON=true
